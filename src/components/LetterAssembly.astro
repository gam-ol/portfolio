<section class="cross-experiment letter-experiment" aria-labelledby="letter-assembly-title">
  <header class="cross-experiment-header">
    <div>
      <p class="eyebrow">canvas / character assembly</p>
      <h2 id="letter-assembly-title" class="cross-experiment-title">Letter Assembly</h2>
    </div>
    <p>
      One drifting character becomes one letter. Together they assemble a word around the pointer.
    </p>
  </header>

  <div
    class="letter-field"
    data-letter-field
    role="img"
    aria-label="Lowercase letters that drift through space and assemble into words around the pointer"
  >
    <canvas data-letter-canvas aria-hidden="true"></canvas>
    <p class="experiment-note">Move or tap to assemble a word.</p>
  </div>
</section>

<script>
  type LetterLifecycle = 'ambient' | 'assembled' | 'releasing' | 'fading-in';

  interface LetterParticle {
    x: number;
    y: number;
    homeX: number;
    homeY: number;
    vx: number;
    vy: number;
    char: string;
    size: number;
    renderSize: number;
    alpha: number;
    renderAlpha: number;
    lifecycle: LetterLifecycle;
    releaseAt: number;
    fadeStartedAt: number;
    fadeDuration: number;
    releaseStartAlpha: number;
    phaseX: number;
    phaseY: number;
    driftX: number;
    driftY: number;
    speedX: number;
    speedY: number;
    targetOffsetX: number | null;
    targetOffsetY: number | null;
    targetSize: number | null;
    letterCenterX: number;
    letterCenterY: number;
    followRate: number;
    scatterX: number;
    scatterY: number;
  }

  interface LetterTarget {
    char: string;
    x: number;
    y: number;
  }

  const words = [
    'hello',
    'there',
    'gam_ol',
    'motion',
    'designer',
    'oh',
    'you',
    'hi',
    'motion',
    'broadcast',
    'realtime',
    'template',
    'system',
    'automation',
    'interactive',
    'code',
    'lottie',
    'canvas',
    'typography',
    'data',
    'visual',
    'workflow',
    'modular',
    'dynamic',
    'oleg',
  ] as const;

  const characterPool = 'abcdefghijklmnopqrstuvwxyz_';
  const wordCoreRadius = 20;
  const wordReleaseRadius = 50;
  const wordFollowRate = 0.04;
  const wordFollowVariance = 0.01;
  const touchWordLifetime = 2000;
  const clamp = (value: number, minimum: number, maximum: number) => Math.min(maximum, Math.max(minimum, value));

  const setupLetterField = async (field: HTMLElement) => {
    const canvas = field.querySelector<HTMLCanvasElement>('[data-letter-canvas]');
    const context = canvas?.getContext('2d');
    if (!canvas || !context) return;

    await document.fonts.ready;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const particles: LetterParticle[] = [];
    const pointer = { x: 0, y: 0, active: false };
    let width = 0;
    let height = 0;
    let frameRequest = 0;
    let resizeRequest = 0;
    let visible = false;
    let wordIndex = -1;
    let wordOriginX = 0;
    let wordOriginY = 0;
    let wordLetterCount = 0;
    let wordIsFormed = false;
    let releasePending = false;
    let pointerInside = false;
    let isTouchWord = false;
    let wordMinX = 0;
    let wordMaxX = 0;
    let wordMinY = 0;
    let wordMaxY = 0;
    let touchTimer = 0;

    const createParticles = () => {
      const amount = clamp(Math.round((width * height) / 1150), 400, 600);
      const characters = Array.from({ length: amount }, (_, index) => characterPool[index % characterPool.length]);

      for (let index = characters.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [characters[index], characters[swapIndex]] = [characters[swapIndex], characters[index]];
      }

      particles.length = 0;
      characters.forEach((char) => {
        const x = Math.random() * width;
        const y = Math.random() * height;
        const size = 7 + Math.random() * 3;
        const alpha = 0.18 + Math.random() * 0.36;
        particles.push({
          x,
          y,
          homeX: x,
          homeY: y,
          vx: 0,
          vy: 0,
          char,
          size,
          renderSize: size,
          alpha,
          renderAlpha: alpha,
          lifecycle: 'ambient',
          releaseAt: 0,
          fadeStartedAt: 0,
          fadeDuration: 0,
          releaseStartAlpha: 0,
          phaseX: Math.random() * Math.PI * 2,
          phaseY: Math.random() * Math.PI * 2,
          driftX: 5 + Math.random() * 15,
          driftY: 5 + Math.random() * 15,
          speedX: 0.00006 + Math.random() * 0.00008,
          speedY: 0.00006 + Math.random() * 0.00008,
          targetOffsetX: null,
          targetOffsetY: null,
          targetSize: null,
          letterCenterX: x,
          letterCenterY: y,
          followRate: 0.04,
          scatterX: 0,
          scatterY: 0,
        });
      });
    };

    const releaseAssembledLetters = (timestamp: number) => {
      particles.forEach((particle) => {
        if (particle.lifecycle !== 'assembled') return;

        particle.targetOffsetX = null;
        particle.targetOffsetY = null;
        particle.targetSize = null;
        particle.lifecycle = 'releasing';
        particle.releaseAt = timestamp + 140 + Math.random() * 760;
        particle.fadeDuration = 1500 + Math.random() * 1500;
        particle.releaseStartAlpha = particle.renderAlpha;
        particle.homeX = clamp(particle.x + (Math.random() - 0.5) * 64, 12, Math.max(12, width - 12));
        particle.homeY = clamp(particle.y + (Math.random() - 0.5) * 64, 12, Math.max(12, height - 12));
        particle.vx *= 0.24;
        particle.vy *= 0.24;
      });
    };

    const clearWord = (timestamp = performance.now()) => {
      pointer.active = false;
      wordIsFormed = false;
      releasePending = false;
      wordLetterCount = 0;
      isTouchWord = false;
      delete field.dataset.activeWord;
      delete field.dataset.assembledLetters;
      delete field.dataset.wordFormed;
      releaseAssembledLetters(timestamp);
    };

    const getLetterTargets = (word: string) => {
      const fontSize = clamp(
        Math.min(height * 0.045, (width * 0.27) / (Math.max(2, word.length) * 0.55)),
        14,
        20,
      );
      const tracking = fontSize * 0.025;
      context.font = `700 ${fontSize}px Lato, sans-serif`;
      const characters = Array.from(word);
      const widths = characters.map((char) => context.measureText(char).width);
      const totalWidth = widths.reduce((sum, letterWidth) => sum + letterWidth, 0) + tracking * (characters.length - 1);
      const targets: LetterTarget[] = [];
      let cursor = -totalWidth / 2;

      characters.forEach((char, index) => {
        const letterWidth = widths[index];
        targets.push({ char, x: cursor + letterWidth / 2, y: 0 });
        cursor += letterWidth + tracking;
      });

      wordMinX = -totalWidth / 2;
      wordMaxX = totalWidth / 2;
      wordMinY = -fontSize * 0.58;
      wordMaxY = fontSize * 0.58;
      return { targets, fontSize };
    };

    const clampWordCenter = (x: number, y: number) => {
      const padding = 32;
      return {
        x: clamp(x, padding - wordMinX, width - padding - wordMaxX),
        y: clamp(y, padding - wordMinY, height - padding - wordMaxY),
      };
    };

    const assignWord = (word: string, timestamp: number) => {
      releaseAssembledLetters(timestamp);
      const { targets, fontSize } = getLetterTargets(word);
      const center = clampWordCenter(pointer.x, pointer.y);
      const available = particles.filter((particle) => particle.lifecycle === 'ambient');
      let assignedLetters = 0;

      targets.forEach((target) => {
        const targetX = center.x + target.x;
        const targetY = center.y + target.y;
        let closestIndex = -1;
        let closestDistance = Number.POSITIVE_INFINITY;

        for (let index = 0; index < available.length; index += 1) {
          const particle = available[index];
          if (particle.char !== target.char) continue;
          const distance = (particle.x - targetX) ** 2 + (particle.y - targetY) ** 2;
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        }

        if (closestIndex < 0) return;
        const [particle] = available.splice(closestIndex, 1);
        particle.targetOffsetX = target.x;
        particle.targetOffsetY = target.y;
        particle.targetSize = fontSize;
        particle.letterCenterX = center.x;
        particle.letterCenterY = center.y;
        particle.followRate = wordFollowRate + (Math.random() * 2 - 1) * wordFollowVariance;
        const scatterAngle = Math.random() * Math.PI * 2;
        const scatterDistance = 10 + Math.random() * 18;
        particle.scatterX = Math.cos(scatterAngle) * scatterDistance;
        particle.scatterY = Math.sin(scatterAngle) * scatterDistance;
        particle.lifecycle = 'assembled';
        assignedLetters += 1;
      });

      wordLetterCount = assignedLetters;
      field.dataset.activeWord = word;
      field.dataset.assembledLetters = String(assignedLetters);
    };

    const showNextWord = (x: number, y: number, timestamp: number) => {
      pointer.x = x;
      pointer.y = y;
      pointer.active = true;
      wordIndex = (wordIndex + 1) % words.length;
      wordOriginX = x;
      wordOriginY = y;
      wordIsFormed = false;
      releasePending = false;
      delete field.dataset.wordFormed;
      assignWord(words[wordIndex], timestamp);
    };

    const replaceWord = (timestamp: number) => {
      const nextX = pointer.x;
      const nextY = pointer.y;
      clearWord(timestamp);
      if (pointerInside) showNextWord(nextX, nextY, timestamp);
    };

    const respawnParticle = (particle: LetterParticle, timestamp: number) => {
      const x = Math.random() * width;
      const y = Math.random() * height;
      particle.x = x;
      particle.y = y;
      particle.homeX = x;
      particle.homeY = y;
      particle.vx = 0;
      particle.vy = 0;
      particle.renderSize = particle.size;
      particle.renderAlpha = 0;
      particle.lifecycle = 'fading-in';
      particle.fadeStartedAt = timestamp + 180 + Math.random() * 820;
      particle.fadeDuration = 1100 + Math.random() * 1300;
      particle.phaseX = Math.random() * Math.PI * 2;
      particle.phaseY = Math.random() * Math.PI * 2;
    };

    const draw = (timestamp: number) => {
      context.clearRect(0, 0, width, height);
      context.textAlign = 'center';
      context.textBaseline = 'middle';

      const pointerDistance = Math.hypot(pointer.x - wordOriginX, pointer.y - wordOriginY);
      const rawScatter = clamp(
        (pointerDistance - wordCoreRadius) / (wordReleaseRadius - wordCoreRadius),
        0,
        1,
      );
      const scatterAmount = wordIsFormed ? rawScatter * rawScatter * (3 - 2 * rawScatter) : 0;
      const centerTarget = clampWordCenter(
        releasePending ? wordOriginX : pointer.x,
        releasePending ? wordOriginY : pointer.y,
      );
      let activeLetterCount = 0;
      let maxTargetDistance = 0;
      let maxSizeDifference = 0;

      particles.forEach((particle) => {
        const isLetter = particle.lifecycle === 'assembled'
          && particle.targetOffsetX !== null
          && particle.targetOffsetY !== null
          && particle.targetSize !== null;
        let targetX = particle.x;
        let targetY = particle.y;

        if (isLetter && pointer.active) {
          particle.letterCenterX += (centerTarget.x - particle.letterCenterX) * particle.followRate;
          particle.letterCenterY += (centerTarget.y - particle.letterCenterY) * particle.followRate;
          targetX = particle.letterCenterX + particle.targetOffsetX! + particle.scatterX * scatterAmount;
          targetY = particle.letterCenterY + particle.targetOffsetY! + particle.scatterY * scatterAmount;
          particle.vx += (targetX - particle.x) * 0.0045;
          particle.vy += (targetY - particle.y) * 0.0045;
          particle.vx *= 0.93;
          particle.vy *= 0.93;
          particle.renderSize += (particle.targetSize! - particle.renderSize) * 0.018;
          particle.renderAlpha += (0.96 - particle.renderAlpha) * 0.035;
        } else if (particle.lifecycle === 'releasing' && timestamp < particle.releaseAt) {
          particle.vx *= 0.94;
          particle.vy *= 0.94;
          particle.renderSize += (particle.size - particle.renderSize) * 0.006;
        } else {
          targetX = particle.homeX + Math.sin(timestamp * particle.speedX + particle.phaseX) * particle.driftX;
          targetY = particle.homeY + Math.cos(timestamp * particle.speedY + particle.phaseY) * particle.driftY;
          const isReleasing = particle.lifecycle === 'releasing';
          particle.vx += (targetX - particle.x) * (isReleasing ? 0.00075 : 0.0014);
          particle.vy += (targetY - particle.y) * (isReleasing ? 0.00075 : 0.0014);
          particle.vx *= isReleasing ? 0.968 : 0.955;
          particle.vy *= isReleasing ? 0.968 : 0.955;
          particle.renderSize += (particle.size - particle.renderSize) * (isReleasing ? 0.007 : 0.018);
        }

        if (particle.lifecycle === 'releasing' && timestamp >= particle.releaseAt) {
          const progress = clamp((timestamp - particle.releaseAt) / particle.fadeDuration, 0, 1);
          const easedProgress = progress * progress * (3 - 2 * progress);
          particle.renderAlpha = particle.releaseStartAlpha * (1 - easedProgress);
          if (progress >= 1) respawnParticle(particle, timestamp);
        } else if (particle.lifecycle === 'fading-in') {
          const progress = clamp((timestamp - particle.fadeStartedAt) / particle.fadeDuration, 0, 1);
          const easedProgress = progress * progress * (3 - 2 * progress);
          particle.renderAlpha = particle.alpha * easedProgress;
          if (progress >= 1) {
            particle.renderAlpha = particle.alpha;
            particle.lifecycle = 'ambient';
          }
        } else if (particle.lifecycle === 'ambient') {
          particle.renderAlpha += (particle.alpha - particle.renderAlpha) * 0.03;
        }

        particle.x += particle.vx;
        particle.y += particle.vy;

        if (isLetter && pointer.active) {
          activeLetterCount += 1;
          maxTargetDistance = Math.max(maxTargetDistance, Math.hypot(targetX - particle.x, targetY - particle.y));
          maxSizeDifference = Math.max(maxSizeDifference, Math.abs(particle.targetSize! - particle.renderSize));
        }

        const assembled = isLetter && pointer.active;
        const emphasized = assembled || particle.lifecycle === 'releasing';
        context.fillStyle = `rgba(17, 17, 17, ${particle.renderAlpha})`;
        context.font = `${emphasized ? 700 : 400} ${particle.renderSize}px Lato, sans-serif`;
        context.fillText(particle.char, particle.x, particle.y);
      });

      if (
        pointer.active
        && !wordIsFormed
        && activeLetterCount === wordLetterCount
        && maxTargetDistance < 2.5
        && maxSizeDifference < 0.8
      ) {
        wordIsFormed = true;
        field.dataset.wordFormed = 'true';
        if (releasePending && !isTouchWord) replaceWord(timestamp);
      }

      frameRequest = visible && !reducedMotion ? requestAnimationFrame(draw) : 0;
    };

    const renderStill = () => draw(performance.now());

    const resize = () => {
      resizeRequest = 0;
      const nextWidth = field.clientWidth;
      const nextHeight = field.clientHeight;
      if (nextWidth < 1 || nextHeight < 1 || (nextWidth === width && nextHeight === height)) return;

      if (frameRequest) {
        cancelAnimationFrame(frameRequest);
        frameRequest = 0;
      }
      width = nextWidth;
      height = nextHeight;
      const pixelRatio = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      pointer.x = width / 2;
      pointer.y = height / 2;
      pointerInside = false;
      clearWord();
      createParticles();
      renderStill();
    };

    field.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch' || reducedMotion) return;
      const bounds = field.getBoundingClientRect();
      const x = event.clientX - bounds.left;
      const y = event.clientY - bounds.top;
      const timestamp = performance.now();
      pointerInside = true;
      isTouchWord = false;
      pointer.x = x;
      pointer.y = y;

      if (!pointer.active) {
        showNextWord(x, y, timestamp);
        return;
      }

      const distance = Math.hypot(x - wordOriginX, y - wordOriginY);
      if (distance >= wordReleaseRadius) {
        if (wordIsFormed) replaceWord(timestamp);
        else releasePending = true;
      }
    }, { passive: true });

    field.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'touch') return;
      pointerInside = false;
      if (!pointer.active) return;
      if (wordIsFormed) clearWord(performance.now());
      else releasePending = true;
    });

    field.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch' || reducedMotion) return;
      const bounds = field.getBoundingClientRect();
      isTouchWord = true;
      pointerInside = false;
      showNextWord(event.clientX - bounds.left, event.clientY - bounds.top, performance.now());
      isTouchWord = true;
      window.clearTimeout(touchTimer);
      touchTimer = window.setTimeout(() => clearWord(performance.now()), touchWordLifetime);
    }, { passive: true });

    const resizeObserver = new ResizeObserver(() => {
      cancelAnimationFrame(resizeRequest);
      resizeRequest = requestAnimationFrame(resize);
    });
    resizeObserver.observe(field);

    const intersectionObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !reducedMotion && !frameRequest) frameRequest = requestAnimationFrame(draw);
      if (!visible && frameRequest) {
        cancelAnimationFrame(frameRequest);
        frameRequest = 0;
      }
    }, { rootMargin: '120px' });
    intersectionObserver.observe(field);

    resize();

    window.addEventListener('pagehide', () => {
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      cancelAnimationFrame(frameRequest);
      cancelAnimationFrame(resizeRequest);
      window.clearTimeout(touchTimer);
    }, { once: true });
  };

  document.querySelectorAll<HTMLElement>('[data-letter-field]').forEach((field) => {
    void setupLetterField(field);
  });
</script>
