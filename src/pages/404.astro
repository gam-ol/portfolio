---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Oleg Gamulinskii" description="The requested page could not be found.">
  <main id="main-content" class="not-found">
    <p class="eyebrow">404</p>
    <h1 class="page-title">Page not found</h1>
    <p class="page-lede">The address may be outdated. The portfolio and all current sections are available from the main navigation.</p>
    <p><a class="button-link" href="/portfolio/">Go to portfolio</a></p>
  </main>
</BaseLayout>
