---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Oleg Gamulinskii — Motion Designer"
  description="Motion designer working with animation, broadcast graphics, infographics, and template systems."
>
  <main id="main-content">
    <section class="intro-section">
      <div class="intro-left">
        <p class="eyebrow">Motion design · Visual systems</p>
        <h1 class="intro-name">Oleg Gamulinskii</h1>
        <p class="intro-tagline">
          Motion designer working with ideas, systems, and storytelling — turning complex things into clear visual motion.
        </p>
        <div class="intro-text">
          <p>
            I am a motion designer with broad production experience — from animation and infographics to broadcast graphics and template systems.
          </p>
          <p>
            I create visual stories, design motion for apps and media, and build tools in After Effects, MOGRT, and CasparCG that help teams deliver content faster and more reliably.
          </p>
          <a class="button-link" href="/portfolio/">View portfolio</a>
        </div>
      </div>

      <div class="intro-right">
        <img
          src="/assets/photo.jpg"
          alt="Oleg Gamulinskii, motion designer"
          class="profile-photo"
          width="280"
          height="350"
        />
        <div class="social-links" aria-label="Social links">
          <a href="https://www.linkedin.com/in/gam-ol/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://www.youtube.com/@Gam_Ol" target="_blank" rel="noopener noreferrer">YouTube</a>
          <a href="https://www.instagram.com/gam_ol/" target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
